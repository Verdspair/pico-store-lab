{
  "name": "@nkanf-dev/pico-store-sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "Typed PICO store protocol and release policy SDK",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/nkanf-dev/pico-store-lab.git", "directory": "packages/ts" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./pico": { "types": "./dist/pico.d.ts", "default": "./dist/pico.js" },
    "./mirror": { "types": "./dist/mirror.d.ts", "default": "./dist/mirror.js" },
    "./releases": { "types": "./dist/releases.d.ts", "default": "./dist/releases.js" }
  },
  "files": ["dist", "README.md"],
  "scripts": { "build": "tsc -p tsconfig.json", "test": "node --test test/*.test.js", "typecheck": "tsc -p tsconfig.json --noEmit" },
  "publishConfig": { "access": "public" },
  "devDependencies": { "typescript": "5.9.3" }
}
