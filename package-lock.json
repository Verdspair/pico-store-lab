{
  "name": "pico-store-workspace",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "pico-store-workspace",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "engines": {
        "node": ">=25"
      }
    },
    "apps/android": {
      "name": "@pico-store/android",
      "version": "0.1.0"
    },
    "apps/desktop": {
      "name": "@pico-store/desktop",
      "version": "0.1.0",
      "dependencies": {
        "@pico-store/shared": "0.1.0"
      },
      "bin": {
        "pico-store": "src/cli.js"
      }
    },
    "apps/website": {
      "name": "@pico-store/website",
      "version": "0.1.0",
      "dependencies": {
        "@nkanf-dev/pico-store-sdk": "0.2.0"
      }
    },
    "node_modules/@nkanf-dev/pico-store-sdk": {
      "resolved": "packages/ts",
      "link": true
    },
    "node_modules/@pico-store/android": {
      "resolved": "apps/android",
      "link": true
    },
    "node_modules/@pico-store/desktop": {
      "resolved": "apps/desktop",
      "link": true
    },
    "node_modules/@pico-store/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@pico-store/website": {
      "resolved": "apps/website",
      "link": true
    },
    "node_modules/typescript": {
      "version": "5.9.3",
      "resolved": "https://registry.npmjs.org/typescript/-/typescript-5.9.3.tgz",
      "integrity": "sha512-jl1vZzPDinLr9eUt3J/t7V6FgNEw9QjvBPdysz9KfQDD41fQrC2Y4vKQdiaUpFT4bXlb1RHhLpp8wtm6M5TgSw==",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/shared": {
      "name": "@pico-store/shared",
      "version": "0.1.0"
    },
    "packages/ts": {
      "name": "@nkanf-dev/pico-store-sdk",
      "version": "0.2.0",
      "license": "MIT",
      "devDependencies": {
        "typescript": "5.9.3"
      }
    }
  }
}
